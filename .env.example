# Optional Formspree / Web3Forms endpoint for contact form submissions
# Example for Web3Forms: https://api.web3forms.com/submit
# Example for Formspree: https://formspree.io/f/your_form_id
VITE_CONTACT_FORM_ENDPOINT=

# Optional custom base path for GitHub Pages deployment (e.g. /my-repo-name/)
# Default is ./ for relative paths
VITE_BASE_PATH=./
